{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "techtree",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "techtree-phone",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev:phone",
        "--",
        "--port",
        "5181",
        "--strictPort"
      ],
      "port": 5181,
      "url": "https://localhost:5181"
    }
  ]
}
